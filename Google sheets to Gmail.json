      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\n// Empty sheet: stop here so no blank email is sent\nif (rows.length === 0) {\n  return [];\n}\n\nconst lines = rows.map((r, i) => {\n  const name = r.Name || r.name || '-';\n  const course = r.Course || r.course || '-';\n  const status = r.Status || r.status || '-';\n  return `${i + 1}. Name: ${name} | Course: ${course} | Status: ${status}`;\n});\n\nconst body = [\n  'Hi,',\n  '',\n  `Here is the latest data from the sheet (${rows.length} records):`,\n  '',\n  ...lines,\n  '',\n  'Regards,',\n  'Your Automation Bot'\n].join('\\n');\n\nreturn [{ json: { subject: 'Data Summary from Google Sheet', body } }];"
      },
      "type": "n8n-nodes-base.code",
